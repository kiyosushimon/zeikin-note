  "adjustment_deduction": {
    "name": "調整控除",
    "purpose": "平成19年の税源移譲で生じた、所得税と個人住民税の人的控除額の差に起因する負担増を調整するための税額控除。",
    "not_applicable_when": "合計所得金額が2,500万円を超える場合は適用なし",
    "formula": {
      "case_taxable_income_le_2000000": "min(人的控除額の差の合計額, 合計課税所得金額) × 5%",
      "case_taxable_income_gt_2000000": "max(人的控除額の差の合計額 − (合計課税所得金額 − 200万円), 5万円) × 5%",
      "minimum_yen": 2500,
      "minimum_note": "合計課税所得金額が200万円超の場合、算定額が2,500円未満なら2,500円（内訳は按分比率による。指定都市: 市民税2,000円・県民税500円。一般市: 市民税1,500円・県民税1,000円）",
      "taxable_income_definition": "合計課税所得金額 = 課税総所得金額 + 課税退職所得金額 + 課税山林所得金額（分離課税分は含まない）"
    },
    "split_ratio": {
      "designated_city": {
        "city_pct_of_5": 4.0,
        "prefecture_pct_of_5": 1.0
